{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTOPIA_DEV_PORT=3001",
        "npm",
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "website-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "website",
        "run",
        "preview"
      ],
      "port": 4322
    }
  ]
}
