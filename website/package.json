    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "astro": "^5.18.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
